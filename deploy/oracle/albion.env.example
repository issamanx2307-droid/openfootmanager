# The public server stays behind Caddy; do not expose this internal port.
ALBION_BIND=127.0.0.1:38421
ALBION_JOIN_SECRET=replace-with-a-long-private-code
ALBION_SAVE=/srv/openfootballmanager/data/career.db
# Set to 1 for hosted service so it never starts with an empty in-memory career.
ALBION_REQUIRE_SAVE=1

# Comma-separated browser origins. Use the public app origin once known.
ALBION_CORS_ORIGINS=https://play.example.com,tauri://localhost

# Used by smoke-check.sh after the TLS reverse proxy is online.
ALBION_PUBLIC_URL=https://play.example.com

# Backup destination on a persistent Oracle volume.
ALBION_BACKUP_DIR=/srv/openfootballmanager/backups

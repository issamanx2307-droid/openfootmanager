[Unit]
Description=OpenFoot Manager Albion authoritative server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ofm
Group=ofm
WorkingDirectory=/srv/openfootballmanager
EnvironmentFile=/etc/openfootballmanager/albion.env
ExecStart=/srv/openfootballmanager/bin/albion_server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/srv/openfootballmanager/data

[Install]
WantedBy=multi-user.target
